{
  "name": "ai-game-components",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Native Game Components Ecosystem for React Native & Expo SDK 58",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hwai-technology/ai-game-component.git"
  },
  "bugs": {
    "url": "https://github.com/Hwai-technology/ai-game-component/issues"
  },
  "homepage": "https://github.com/Hwai-technology/ai-game-component#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "node --import tsx --test 'core/**/tests/*.test.ts' 'components/**/tests/*.test.ts' 'cli/tests/*.test.ts' 'examples/**/tests/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "gamekit": "node --import tsx cli/bin/gamekit.ts"
  },
  "workspaces": [
    "core/*",
    "components/*",
    "cli",
    "examples/*"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@12.2.2",
  "type": "module"
}
